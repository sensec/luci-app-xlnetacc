#!/bin/sh

# 仅在配置不存在时创建，升级时保留用户配置
if [ ! -f /etc/config/xlnetacc ]; then
	cp /usr/share/luci-app-xlnetacc/xlnetacc.default /etc/config/xlnetacc
	chmod 600 /etc/config/xlnetacc
fi

uci -q batch <<-EOF >/dev/null
	delete ucitrack.@xlnetacc[-1]
	add ucitrack xlnetacc
	set ucitrack.@xlnetacc[-1].init=xlnetacc
	commit ucitrack
EOF

general=$(uci -q get xlnetacc.@general[-1])
if [ -z "$general" ]; then
	uci -q add xlnetacc general
fi
if [ "$general"x != "general"x ]; then
	uci -q batch <<-EOF >/dev/null
		rename xlnetacc.@general[-1]="general"
		commit xlnetacc
	EOF
fi

rm -rf /tmp/luci-indexcache /tmp/luci-modulecache
exit 0
